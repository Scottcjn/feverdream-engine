+// ---------------------------------------------------------------------------
+// Feverdream persistent worker pool (the .kkrieger lesson, FINDINGS.md).
+//
+// Stock POV spawns a fresh boost::thread for EVERY task — per frame in the
+// resident engine that's 1 parser task + N trace tasks created and joined,
+// ~3 ms of pure thread churn at 8 threads (measured, GAME_ENGINE.md research:
+// persistent pools fed per-frame are standard real-time raytracing practice).
+//
+// Workers are created on demand (never more than the max concurrent task
+// count), run TaskThread jobs in a loop, and live for the process lifetime.
+// Each job still does its own POVMS_OpenContext / POV_SYS_THREAD_STARTUP /
+// CLEANUP inside TaskThread, so per-task semantics are unchanged — only the
+// OS thread create/join is amortized. Set FD_NO_TASK_POOL=1 to fall back to
+// stock thread-per-task behavior.
+// ---------------------------------------------------------------------------
+namespace
+{
+
+struct FdJob
+{
+	boost::function0<void> fn;
+	bool done;
+	boost::mutex m;
+	boost::condition_variable cv;
+	FdJob(const boost::function0<void>& f) : fn(f), done(false) { }
+};
+
+class FdTaskPool
+{
+	public:
+		static FdTaskPool& Instance()
+		{
+			static FdTaskPool pool;
+			return pool;
+		}
+
+		FdJob *Submit(const boost::function0<void>& fn)
+		{
+			FdJob *job = new FdJob(fn);
+			boost::mutex::scoped_lock lock(m);
+			// a worker is spawned only when none are idle; pool size converges
+			// on the max concurrent task count and never shrinks
+			if(idle == 0)
+				workers.push_back(Task::NewBoostThread(boost::bind(&FdTaskPool::Worker, this), POV_THREAD_STACK_SIZE));
+			queue.push_back(job);
+			cv.notify_one();
+			return job;
+		}
+
+		// join-equivalent: blocks until the job has fully finished (TaskThread
+		// returned, completion() called), then frees it
+		void Wait(FdJob *job)
+		{
+			{
+				boost::mutex::scoped_lock lock(job->m);
+				while(job->done == false)
+					job->cv.wait(lock);
+			}
+			delete job;
+		}
+
+	private:
+		boost::mutex m;
+		boost::condition_variable cv;
+		std::deque<FdJob *> queue;
+		std::vector<boost::thread *> workers;   // live for the process lifetime
+		int idle;
+
+		FdTaskPool() : idle(0) { }
+
+		void Worker()
+		{
+			for(;;)
+			{
+				FdJob *job;
+				{
+					boost::mutex::scoped_lock lock(m);
+					idle++;
+					while(queue.empty() == true)
+						cv.wait(lock);
+					idle--;
+					job = queue.front();
+					queue.pop_front();
+				}
+				job->fn();
+				// after the unlock below the waiter may delete job — do not
+				// touch it again
+				boost::mutex::scoped_lock jlock(job->m);
+				job->done = true;
+				job->cv.notify_all();
+			}
+		}
+};
+
+bool FdPoolEnabled()
+{
+	static const bool disabled = (getenv("FD_NO_TASK_POOL") != NULL);
+	return disabled == false;
+}
+
+}
