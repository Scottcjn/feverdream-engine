// fd-daemon.rc — Windows resources for the Feverdream POV-Ray render daemon.
// Embeds version info, an application manifest, and an icon so the binary
// carries real provenance (the no-cost half of avoiding antivirus false
// positives; the other half is Authenticode signing — see ../game/SIGNPATH_SETUP.md).
// Compiled with MSVC rc.exe and linked into fd-daemon.exe by build-daemon-msvc.bat.
#include <windows.h>

1 ICON "fd-daemon.ico"
1 RT_MANIFEST "fd-daemon.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    0,4,0,0
 PRODUCTVERSION 0,4,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "Elyan Labs"
      VALUE "FileDescription",  "Feverdream Engine - POV-Ray render daemon (renderer for Chunkins)"
      VALUE "FileVersion",      "0.4.0.0"
      VALUE "InternalName",     "fd-daemon"
      VALUE "LegalCopyright",   "Copyright (C) 2026 Elyan Labs. Bundles POV-Ray (AGPLv3)."
      VALUE "OriginalFilename", "fd-daemon.exe"
      VALUE "ProductName",      "Chunkins / Feverdream Engine"
      VALUE "ProductVersion",   "0.4.0.0"
      VALUE "Comments",         "Renders scenes locally for fd-game. Source: https://github.com/Scottcjn/feverdream-engine"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
